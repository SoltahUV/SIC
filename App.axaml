<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:converters="using:SIC.Converters"
             xmlns:local="using:SIC"
             x:Class="SIC.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            
            <converters:ImageFormatConverter
                x:Key="ImageFormatConverter"/>
            

            <Color x:Key="BackgroundColor">
                #202020
            </Color>

            <Color x:Key="CardColor">
                #2D2D2D
            </Color>

            <SolidColorBrush x:Key="AppBackgroundBrush"
                             Color="#202020"/>

            <SolidColorBrush x:Key="CardBrush"
                             Color="#353535"/>

            <SolidColorBrush x:Key="LogBackground"
                             Color="#1E1E1E"/>

            <SolidColorBrush x:Key="CardBorderBrush"
                             Color="#555555"/>

            <SolidColorBrush x:Key="TextColor"
                             Color="#E6E6E6"/>

            <SolidColorBrush x:Key="SecondaryTextColor"
                             Color="#888888"/>

            <SolidColorBrush x:Key="TitleTextColor"
                             Color="#FFFFFF"/>

            <SolidColorBrush x:Key="AccentColor"
                             Color="#FFFFFF"/>

            <SolidColorBrush x:Key="PrimaryButtonBrush"
                             Color="#4CAF50"/>

            <SolidColorBrush x:Key="PrimaryButtonHoverBrush"
                             Color="#5CBF60"/>

            <SolidColorBrush x:Key="PrimaryButtonPressedBrush"
                             Color="#3D9140"/>


            <SolidColorBrush x:Key="DangerButtonBrush"
                             Color="#E53935"/>

            <SolidColorBrush x:Key="DangerButtonHoverBrush"
                             Color="#EF5350"/>

            <SolidColorBrush x:Key="DangerButtonPressedBrush"
                             Color="#C62828"/>

            <SolidColorBrush x:Key="ErrorColor"
                             Color="#F44747"/>

            <SolidColorBrush x:Key="WarningColor"
                             Color="#DCDCAA"/>
            
            <SolidColorBrush x:Key="ThemeBackgroundBrush"
                             Color="#202020"/>

            <SolidColorBrush x:Key="ThemeControlBackgroundBrush"
                             Color="#2D2D2D"/>

            <SolidColorBrush x:Key="ThemeControlAltBackgroundBrush"
                             Color="#353535"/>

            <SolidColorBrush x:Key="ThemeBorderLowBrush"
                             Color="#444444"/>

            <SolidColorBrush x:Key="ThemeBorderMidBrush"
                             Color="#555555"/>

            <SolidColorBrush x:Key="ThemeForegroundLowBrush"
                             Color="#888888"/>

            <SolidColorBrush x:Key="ThemeForegroundBrush"
                             Color="#E6E6E6"/>

            <SolidColorBrush x:Key="ThemeForegroundHighBrush"
                             Color="#FFFFFF"/>
            

            <SolidColorBrush x:Key="ThemeAccentBrush"
                             Color="#FFFFFF"/>

            <SolidColorBrush x:Key="ThemeAccentColor"
                             Color="#FFFFFF"/>

        </ResourceDictionary>
    </Application.Resources>


    <Application.Styles>

        <FluentTheme/>

        <materialIcons:MaterialIconStyles />

        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />
        
        <Style Selector="Border">
            <Setter Property="CornerRadius"
                    Value="10"/>
        </Style>
        
        <Style Selector="Window /template/ Border">
            <Setter Property="CornerRadius"
                    Value="0"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="12,5"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource ThemeControlBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryButtonBrush}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryButtonHoverBrush}"/>
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryButtonPressedBrush}"/>
        </Style>
        
        <Style Selector="Button.danger">
            <Setter Property="Background"
                    Value="{DynamicResource DangerButtonBrush}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource DangerButtonHoverBrush}"/>
        </Style>

        <Style Selector="Button.danger:pressed">
            <Setter Property="Background"
                    Value="{DynamicResource DangerButtonPressedBrush}"/>
        </Style>


        <Style Selector="TextBox">
            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Background"
                    Value="{DynamicResource ThemeControlBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
        </Style>
        

        <Style Selector="ComboBox">
            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Background"
                    Value="{DynamicResource ThemeControlBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
        </Style>

        

        <Style Selector="Slider">
            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AccentColor}"/>
        </Style>

        

        <Style Selector="CheckBox">
            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
        </Style>
        

        <Style Selector="Border.card">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="Background"
                    Value="{DynamicResource CardBrush}"/>
        </Style>
        

        <Style Selector="TextBlock.title">
            <Setter Property="Foreground"
                    Value="{DynamicResource TitleTextColor}"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="14"/>
        </Style>


        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextColor}"/>

            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

    </Application.Styles>

</Application>
